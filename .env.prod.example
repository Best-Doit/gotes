# Aplicación
DJANGO_SECRET_KEY=reemplazar-con-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=gotes.example.com,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://gotes.example.com
GOTES_PUBLIC_URL=https://gotes.example.com
GOTES_EVIDENCE_MAX_FILE_SIZE_MB=5

# PostgreSQL interno
POSTGRES_DB=gotes
POSTGRES_USER=gotes
POSTGRES_PASSWORD=reemplazar-con-una-clave-segura
POSTGRES_SSLMODE=disable
POSTGRES_CONN_MAX_AGE=60

# Gunicorn: escucha internamente en 8000; Docker publica el puerto 8009
GUNICORN_CMD_ARGS=--bind 0.0.0.0:8000 --workers 3 --threads 2 --timeout 60 --access-logfile - --error-logfile -

# HTTPS detrás de Nginx, Caddy, Traefik o Cloudflare Tunnel
DJANGO_TRUST_PROXY_HEADERS=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=0

# Gmail SMTP
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=correo@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=reemplazar-con-password-de-aplicacion
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_USE_SSL=0
DJANGO_EMAIL_TIMEOUT=15
DJANGO_DEFAULT_FROM_EMAIL="GOTES <correo@gmail.com>"
GOTES_EMAIL_MAX_ATTEMPTS=5
GOTES_EMAIL_PROCESSING_TIMEOUT_MINUTES=15
